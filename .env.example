# DocuMind environment configuration.
#
# Every model this project actually uses runs locally (Ollama for
# generation and nomic-embed-text, sentence-transformers in-process) --
# no API key is required to run anything in this repo as built. The keys
# below are only relevant if you swap in one of the hosted alternatives
# named in the project plan's tech stack table (§3).

# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# COHERE_API_KEY=

# Ollama daemon location, if not the default.
OLLAMA_BASE_URL=http://localhost:11434

# FastAPI server (api/main.py), if not uvicorn's defaults.
API_HOST=0.0.0.0
API_PORT=8000
